# Streamlit Cloud / Production Secrets Configuration
# For Streamlit Community Cloud (share.streamlit.io):
# 1. Open your app on share.streamlit.io
# 2. Click App Settings (⋮) -> Secrets
# 3. Paste the contents below and click Save:

# 🤖 OpenAI API Key
OPENAI_API_KEY = "your_openai_api_key_here"

# 📧 BlackBox SMTP Email Service (unitread.blackbox.in)
# (Enables 1-Click Background Bulk Sending without Outlook)
SMTP_HOST = "smtp.blackbox.in"
SMTP_PORT = 465
SMTP_USE_TLS = false
SENDER_EMAIL = "sandeep.yadav@unitread.co.in"
SMTP_PASSWORD = "your_blackbox_password_here"

# Sender Profile Details
SENDER_NAME = "Sandeep Yadav"
COMPANY_NAME = "United Tyrekrafts Pvt. Ltd."
SENDER_PHONE = "9682548514"
